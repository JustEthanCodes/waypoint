# Waypoint environment variables
# None are required for the core app. Transitous needs no key.

# REQUIRED for contact compliance (displayed on /about and sent upstream if desired)
PUBLIC_CONTACT_URL=https://github.com/your-org/waypoint

# Optional: Transitland v2 API key (free Interline account) — used ONLY as a
# fallback for departures when Transitous is unavailable. https://transit.land/plans-pricing
TRANSITLAND_API_KEY=

# Optional: used by the nightly ETL (scripts/etl.mjs) to query the Mobility Database catalog
MOBILITY_DATABASE_REFRESH_TOKEN=
