{
  "name": "waypoint",
  "version": "0.1.0",
  "description": "Waypoint — a minimalist, Mini Metro-style map of every public transport system on Earth. Open source.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-worker.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/copy-worker.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "etl": "node scripts/etl.mjs",
    "etl:nyc-subway": "node scripts/etl.mjs --city=nyc-subway",
    "etl:boston": "node scripts/etl.mjs --city=boston"
  },
  "dependencies": {
    "@lucide/svelte": "^1.76.0",
    "maplibre-gl": "^6.19.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "adm-zip": "^0.6.1",
    "csv-parse": "^7.0.3",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
